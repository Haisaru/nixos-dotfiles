{
	"custom/notifications": {
		"exec": "~/.config/waybar/scripts/notifications.sh",
		"return-type": "json",
		"interval": 2,
		"signal": 9,
		"min-length": 2,
		"max-length": 2,
		"on-click": "~/.config/waybar/scripts/notifications.sh dnd",
		"on-click-right": "~/.config/waybar/scripts/notifications.sh restore",
		"on-click-middle": "~/.config/waybar/scripts/notifications.sh clear"
	}
}
