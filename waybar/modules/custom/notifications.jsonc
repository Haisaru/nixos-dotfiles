{
	"custom/notifications": {
		"exec": "swaync-client -swb",
		"return-type": "json",
		"escape": true,
		"format": "{icon}",
		"format-icons": {
			"notification": "󱅫",
			"none": "󰂚",
			"dnd-notification": "󰂛",
			"dnd-none": "󰂛",
			"inhibited-notification": "󱅫",
			"inhibited-none": "󰂚",
			"dnd-inhibited-notification": "󰂛",
			"dnd-inhibited-none": "󰂛"
		},
		"min-length": 2,
		"max-length": 2,
		"on-click": "swaync-client -t -sw",
		"on-click-right": "swaync-client -d -sw",
		"on-click-middle": "swaync-client -C -sw"
	}
}
