{
	"custom/ime": {
		"exec": "~/.config/waybar/scripts/ime.sh",
		"return-type": "json",
		"interval": 1,
		"signal": 10,
		"min-length": 2,
		"on-click": "~/.config/waybar/scripts/ime.sh next",
		"on-click-right": "~/.config/waybar/scripts/ime.sh prev",
		"on-click-middle": "~/.config/waybar/scripts/ime.sh config"
	}
}
